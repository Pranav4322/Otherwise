# Copy this file to .env and set a real secret before deploying.
# The server falls back to an insecure default if this isn't set,
# which is fine for trying things out locally but not for production.
JWT_SECRET=replace-with-a-long-random-string
PORT=3000

# URL of your deployed frontend (comma-separate for multiple). Leave unset
# for local dev, where any origin is allowed.
CORS_ORIGIN=https://your-frontend.vercel.app
